{
    "compilerOptions": {
        "target": "ES2020",
        "module": "ES2020",
        "moduleResolution": "Bundler",
        "declaration": true,
        "emitDeclarationOnly": true,
        "outDir": "dist",
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true
    },
    "include": [
        "index.ts",
        "types.ts",
        "configSystem.ts",
        "moduleSystem.ts",
        "upgradeTools.ts",
        "checker/**/*.ts",
        "methods/**/*.ts",
        "gradeMakers/**/*.ts",
        "queueUpdaters/**/*.ts"
    ]
}